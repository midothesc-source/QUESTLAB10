# GEMINI_API_KEY: Required for server-side Gemini AI mission generation.
# AI Studio injects this at runtime from user secrets. Never prefix with VITE_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model override for mission generation (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (optional overrides when deploying outside AI Studio;
# AI Studio automatically provisions firebase-applet-config.json).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Firebase Admin SDK (server-side JSON service account string for privileged role claims,
# server-only answer key storage, and authoritative progress writes in production).
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Optional secret used by trusted server scripts to promote an initial teacher account.
ADMIN_SETUP_SECRET=""
